# Adaptive Refresh Rate
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.use_content_detection=true
ro.surface_flinger.set_idle_timer_ms=3000
ro.surface_flinger.set_touch_timer_ms=500
ro.surface_flinger.set_display_power_timer_ms=1000

# SurfaceFlinger HWC Optimizasyonu - GPU yerine HWC katmanini daha fazla kullan
debug.sf.latch_unsignaled=0
debug.sf.disable_backpressure=0
ro.surface_flinger.max_frame_buffer_acquired_buffers=3

# V4A / Audio Buffer Optimizasyonu - Daha buyuk buffer = daha az CPU uyanmasi
vendor.audio.offload.buffer.size.kb=256
vendor.audio.hal.output.suspend.time=6000
